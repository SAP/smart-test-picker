<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion><groupId>fixture</groupId><artifactId>executable-reactor</artifactId><version>1</version><packaging>pom</packaging>
  <modules><module>module-a</module><module>module-b</module><module>module-zero</module></modules>
  <properties><maven.compiler.release>17</maven.compiler.release><smartTestPicker.revision>reactor-revision</smartTestPicker.revision><smartTestPicker.shardId>reactor-shard</smartTestPicker.shardId></properties>
  <dependencyManagement><dependencies><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.9.3</version></dependency></dependencies></dependencyManagement>
  <dependencies><dependency><groupId>com.sap.oss.smart-test-picker</groupId><artifactId>smart-test-picker-core</artifactId><version>0.3.0-SNAPSHOT</version><scope>test</scope></dependency></dependencies>
  <build><pluginManagement><plugins><plugin><groupId>com.sap.oss.smart-test-picker</groupId><artifactId>smart-test-picker-maven</artifactId><version>0.3.0-SNAPSHOT</version></plugin></plugins></pluginManagement><plugins>
    <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.13</version><executions><execution><goals><goal>prepare-agent</goal></goals></execution></executions><configuration><destFile>${project.build.directory}/jacoco/test.exec</destFile><append>false</append></configuration></plugin>
    <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version><configuration><includesFile>${surefire.includesFile}</includesFile><failIfNoSpecifiedTests>${surefire.failIfNoSpecifiedTests}</failIfNoSpecifiedTests><properties><configurationParameters>junit.jupiter.extensions.autodetection.enabled = true</configurationParameters></properties><systemPropertyVariables><stp.exec.dir>${project.build.directory}/jacoco</stp.exec.dir><smartTestPicker.schemaVersion>${smartTestPicker.schemaVersion}</smartTestPicker.schemaVersion><smartTestPicker.executionTarget>${smartTestPicker.executionTarget}</smartTestPicker.executionTarget></systemPropertyVariables></configuration></plugin>
    <plugin><artifactId>maven-failsafe-plugin</artifactId><version>3.5.3</version><configuration><includesFile>${failsafe.includesFile}</includesFile><failIfNoSpecifiedTests>${failsafe.failIfNoSpecifiedTests}</failIfNoSpecifiedTests><properties><configurationParameters>junit.jupiter.extensions.autodetection.enabled = true</configurationParameters></properties><systemPropertyVariables><stp.exec.dir>${project.build.directory}/jacoco</stp.exec.dir><smartTestPicker.schemaVersion>${smartTestPicker.schemaVersion}</smartTestPicker.schemaVersion><smartTestPicker.executionTarget>${smartTestPicker.executionTarget}</smartTestPicker.executionTarget></systemPropertyVariables></configuration></plugin>
    <plugin><groupId>com.sap.oss.smart-test-picker</groupId><artifactId>smart-test-picker-maven</artifactId><version>0.3.0-SNAPSHOT</version><dependencies><dependency><groupId>com.sap.oss.smart-test-picker</groupId><artifactId>smart-test-picker-core</artifactId><version>0.3.0-SNAPSHOT</version></dependency></dependencies><configuration><moduleFragmentOutput>${smartTestPicker.moduleFragmentOutput}</moduleFragmentOutput><moduleEvidenceOutput>${smartTestPicker.moduleEvidenceOutput}</moduleEvidenceOutput></configuration><executions>
      <execution><id>reports</id><phase>verify</phase><goals><goal>generate-reports</goal></goals></execution>
      <execution><id>fragment</id><phase>verify</phase><goals><goal>generate-coverage-fragment</goal></goals></execution>
    </executions></plugin>
  </plugins></build>
  <profiles>
    <profile><id>failsafe</id><build><plugins><plugin><artifactId>maven-failsafe-plugin</artifactId><executions><execution><id>fixture-it</id><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin></plugins></build></profile>
    <profile><id>literal-jacoco-argline</id><properties><jacoco.skip>true</jacoco.skip></properties><build><plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version><executions><execution><id>copy-agent</id><phase>process-test-classes</phase><goals><goal>copy</goal></goals><configuration><artifactItems><artifactItem><groupId>org.jacoco</groupId><artifactId>org.jacoco.agent</artifactId><version>0.8.13</version><classifier>runtime</classifier><outputDirectory>${project.build.directory}/stp-fixture</outputDirectory><destFileName>jacocoagent.jar</destFileName></artifactItem></artifactItems></configuration></execution></executions></plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId><configuration><argLine>-Xmx256m -Dsome.project.property=true -javaagent:${project.build.directory}/stp-fixture/jacocoagent.jar=destfile=${project.build.directory}/jacoco.exec</argLine></configuration></plugin>
    </plugins></build></profile>
    <profile><id>no-jacoco-agent</id><properties><jacoco.skip>true</jacoco.skip></properties><build><plugins>
      <plugin><artifactId>maven-surefire-plugin</artifactId><configuration><argLine>-Xmx256m -Dsome.project.property=true</argLine></configuration></plugin>
    </plugins></build></profile>
  </profiles>
</project>
